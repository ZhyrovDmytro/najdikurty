# Render/API runtime connection. Prefer the Supabase Session pooler on port 5432
# when the host does not support IPv6.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@REGION.pooler.supabase.com:5432/postgres

# Drizzle migration connection. Prefer the direct Supabase connection when IPv6
# is available; otherwise the Session pooler URL can be reused.
MIGRATION_DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Optional/required provider credentials for indexed manual or scheduled refreshes.
# Padel Slavia requires credentials for non-current dates.
PADEL_SLAVIA_EMAIL=
PADEL_SLAVIA_PASSWORD=
PADEL_SLAVIA_BROWSER=0
PADEL_SLAVIA_BROWSER_HEADLESS=true
PADEL_SLAVIA_BROWSER_TIMEOUT_MS=45000

# Bookaball can currently expose public availability; credentials enable an
# authenticated Padel Džus session when needed.
BOOKABALL_EMAIL=
BOOKABALL_PASSWORD=

# Phase 7 background indexing. Times are local to SCRAPE_SCHEDULE_TIMEZONE.
SCRAPE_SCHEDULE_TIMEZONE=Europe/Prague
SCRAPE_SCHEDULE_START=08:00
SCRAPE_SCHEDULE_END=22:00
SCRAPE_TARGET_HORIZON_DAYS=14
SCHEDULER_INTERVAL_MS=900000
WORKER_CONCURRENCY=4
WORKER_PROVIDER_CONCURRENCY=1
# Optional JSON overrides, for example: {"playtomic":2,"padelslavia":1}
WORKER_PROVIDER_CONCURRENCY_OVERRIDES=
WORKER_POLL_INTERVAL_MS=5000
WORKER_SCRAPE_TIMEOUT_MS=45000
WORKER_LOCK_TIMEOUT_MS=300000
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_MS=60000
WORKER_RETRY_MAX_MS=900000
